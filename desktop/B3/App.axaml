<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            
             x:Class="B3.App"
             xmlns:local="using:B3"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <Color x:Key="PrimaryColor">#4C7ED6</Color>
        <Color x:Key="PrimaryDarkColor">#355AA5</Color>
        <Color x:Key="SurfaceColor">#151A23</Color>
        <Color x:Key="PageBgColor">#0F131A</Color>
        <Color x:Key="SidebarBgColor">#121823</Color>
        <Color x:Key="MutedTextColor">#A1A8B3</Color>
        <Color x:Key="TextColor">#E6E9EE</Color>
        <Color x:Key="TagBgColor">#1E2A3D</Color>
        <Color x:Key="TagAltBgColor">#222036</Color>
        <Color x:Key="IconBgColor">#1B2434</Color>
        <Color x:Key="SoftPanelColor">#121720</Color>
        <Color x:Key="CardBorderColor">#1F2633</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="PageBgBrush" Color="{StaticResource PageBgColor}"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TagBgBrush" Color="{StaticResource TagBgColor}"/>
        <SolidColorBrush x:Key="TagAltBgBrush" Color="{StaticResource TagAltBgColor}"/>
        <SolidColorBrush x:Key="IconBgBrush" Color="{StaticResource IconBgColor}"/>
        <SolidColorBrush x:Key="SoftPanelBrush" Color="{StaticResource SoftPanelColor}"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
        <x:Double x:Key="GlobalFontSize">14</x:Double>
        <FontFamily x:Key="GlobalFontFamily">Segoe UI Variable Text, Microsoft JhengHei UI, Noto Sans TC</FontFamily>
        <!-- Spacing & radii -->
        <x:Double x:Key="SpacingSmall">6</x:Double>
        <x:Double x:Key="Spacing">12</x:Double>
        <x:Double x:Key="SpacingLarge">20</x:Double>
        <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
        <CornerRadius x:Key="RadiusMedium">10</CornerRadius>

        <!-- Animation timing -->
        <x:Double x:Key="AnimShort">0.12</x:Double>
        <x:Double x:Key="AnimMedium">0.22</x:Double>

        <!-- Elevation brush for subtle outlines -->
        <SolidColorBrush x:Key="ElevationBrush" Color="#000000" Opacity="0.06"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource PageBgBrush}"/>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="ListBox.nav-menu">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="ListBox.nav-menu TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style Selector="ListBox.nav-menu ListBoxItem">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style Selector="ListBox.nav-menu ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SoftPanelBrush}"/>
        </Style>

        <Style Selector="ListBox.nav-menu ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="ListBox.nav-menu ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="ListBox.nav-menu ListBoxItem:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style Selector="Button.card-button:pointerover Border.card">
            <Setter Property="Background" Value="{DynamicResource SoftPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <Style Selector="Button.card-button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.card-button:pointerover">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.card-button:pressed Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource SoftPanelBrush}"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.card:pointerover">
            <Setter Property="Background" Value="{DynamicResource SoftPanelBrush}"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SoftPanelBrush}"/>
        </Style>

        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Application.Styles>
</Application>