<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             xmlns:loc="using:B3.Localization"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="B3.Views.QuestionHubView"
             x:DataType="vm:QuestionHubViewModel">

    <Border Classes="card">
        <StackPanel Spacing="8">
            <TextBlock FontSize="18" FontWeight="Bold" Text="{loc:Loc QuestionHubTitle}"/>
            <TextBlock Classes="muted" Text="{loc:Loc QuestionHubDesc}"/>
        </StackPanel>
    </Border>
</UserControl>
