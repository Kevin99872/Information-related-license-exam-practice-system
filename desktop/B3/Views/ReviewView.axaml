<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             xmlns:loc="using:B3.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="B3.Views.ReviewView"
             x:DataType="vm:ReviewViewModel">

    <Grid ColumnDefinitions="300,*" Margin="10">
        <!-- 左側: 待審核題目列表 -->
        <StackPanel Grid.Column="0" Spacing="10">
            <TextBlock Text="{loc:Loc PendingProblems}" FontSize="16" FontWeight="Bold"/>
            
            <ListBox ItemsSource="{Binding PendingProblems}" 
                     SelectedItem="{Binding CurrentReviewProblem}"
                     SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding ProblemCode}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- 右側: 審核詳情 -->
        <StackPanel Grid.Column="1" Spacing="10" Margin="10,0,0,0">
            <!-- 題目詳情 -->
            <TextBlock Text="{Binding CurrentReviewProblem.Title}" FontSize="16" FontWeight="Bold"/>
            <TextBox Text="{Binding CurrentReviewProblem.Description}" 
                     AcceptsReturn="True" Height="100" IsReadOnly="True" Background="#F5F5F5"/>

            <!-- 審核者信息 -->
            <TextBlock Text="{loc:Loc Reviewer}" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBox Text="{Binding ReviewerName}" PlaceholderText="{loc:Loc ReviewerPlaceholder}"/>

            <!-- 審核意見 -->
            <TextBlock Text="{loc:Loc ReviewComments}" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBox Text="{Binding ReviewComments}"
                     AcceptsReturn="True" Height="100"
                     PlaceholderText="{loc:Loc ReviewCommentsPlaceholder}"/>

            <!-- 操作按鈕 -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <Button Content="{loc:Loc ApproveReview}" Width="150" Background="#4CAF50" Foreground="White"/>
                <Button Content="{loc:Loc RejectReview}" Width="150" Background="#F44336" Foreground="White"/>
                <Button Content="{loc:Loc UpdateComments}" Width="150" Background="#2196F3" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Grid>

</UserControl>
