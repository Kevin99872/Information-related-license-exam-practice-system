<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="B3.Views.CodeSpaceView"
             x:DataType="vm:CodeSpaceViewModel">

    <Border Background="#1E1E1E" CornerRadius="12" Padding="16">
        <Grid ColumnDefinitions="220,220,*" RowDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="12">
            <!-- 頂部標籤列 -->
            <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Background="#2D2D2D" CornerRadius="8" Padding="10,6">
                        <TextBlock Foreground="White" Text="solution"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <ComboBox Width="120" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"/>
                    <Button Content="執行" Classes="primary" Command="{Binding RunCodeCommand}" IsEnabled="{Binding IsNotRunning}"/>
                </StackPanel>
            </Grid>

            <!-- 專案列表 -->
            <StackPanel Grid.Row="1" Spacing="10">
                <TextBlock Foreground="#9CA3AF" Text="專案"/>
                <ListBox ItemsSource="{Binding Projects}" Background="#111827" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="White" Text="{Binding}" Margin="8"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Foreground="#9CA3AF" Text="題庫" Margin="0,12,0,0"/>
                <ListBox ItemsSource="{Binding Repositories}" Background="#111827" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="#E5E7EB" Text="{Binding}" Margin="8"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- 檔案樹 -->
            <Border Grid.Row="1" Grid.Column="1" Background="#111827" CornerRadius="10" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Foreground="#9CA3AF" Text="檔案"/>
                    <TextBlock Foreground="White" Text="cpe_practice"/>
                    <TextBlock Foreground="#E5E7EB" Text="solution.cpp" Margin="8,0,0,0"/>
                    <TextBlock Foreground="#E5E7EB" Text="test_cases.txt" Margin="8,0,0,0"/>
                    <TextBlock Foreground="#E5E7EB" Text="README.md" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- 編輯器 -->
            <Border Grid.Row="1" Grid.Column="2" Background="#111827" CornerRadius="10" Padding="12">
                <TextBox Text="{Binding Code}" AcceptsReturn="True" Background="#111827" Foreground="#E5E7EB" BorderThickness="0" Height="360"/>
            </Border>

            <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Background="#111827" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="6">
                        <TextBlock Foreground="#9CA3AF" Text="輸入"/>
                        <TextBox Text="{Binding Input}" AcceptsReturn="True" Background="#111827" Foreground="#E5E7EB" BorderThickness="0" Height="100"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#111827" CornerRadius="10" Padding="12">
                    <StackPanel Spacing="6">
                        <TextBlock Foreground="#9CA3AF" Text="輸出"/>
                        <TextBox Text="{Binding Output}" AcceptsReturn="True" IsReadOnly="True" Background="#111827" Foreground="#E5E7EB" BorderThickness="0" Height="100"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
