<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             xmlns:loc="using:B3.Localization"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="B3.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <ScrollViewer>
        <StackPanel Spacing="24" Margin="0,6,0,6">
            <Border Classes="card" Padding="26">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6">
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="24" FontWeight="Bold" Text="{loc:Loc QuickSim}"/>
                        <TextBlock Classes="muted" Text="{loc:Loc QuickSimDesc}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="{loc:Loc ImportBank}" Classes="ghost" Command="{Binding GoToImportCommand}"/>
                        <Button Content="{loc:Loc StartPractice}" Classes="primary"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 熱門考照題庫 -->
            <StackPanel Spacing="14">
                <TextBlock FontWeight="Bold" FontSize="16" Text="{loc:Loc HotBanks}"/>
                <TextBlock Classes="muted" Text="{loc:Loc HotBanksDesc}"/>

            <Border Classes="card" IsVisible="{Binding HasNoBanks}" Padding="40" MinHeight="240" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="360">
                    <Border Width="56" Height="56" Background="{DynamicResource IconBgBrush}" CornerRadius="28" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Text="{loc:Loc NoBanksTitle}"/>
                    <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Text="{loc:Loc NoBanksDesc}"/>
                    <Button Classes="primary" HorizontalAlignment="Center" Content="{loc:Loc ImportBank}" Command="{Binding GoToImportCommand}"/>
                </StackPanel>
            </Border>

            <ItemsControl IsVisible="{Binding !HasNoBanks}" ItemsSource="{Binding HotCards}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="card-button" Padding="0" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding $parent[ItemsControl].DataContext.StartExamCommand}"
                                CommandParameter="{Binding .}">
                            <Border Classes="card" Margin="0" MinHeight="160" Padding="20">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                    <Border Width="30" Height="30" Background="{DynamicResource IconBgBrush}" CornerRadius="7"/>

                                    <StackPanel Grid.Column="1" Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Title}"/>
                                            <Border Grid.Column="1" HorizontalAlignment="Right" Padding="8,3" Background="{DynamicResource TagBgBrush}" CornerRadius="10">
                                                <TextBlock FontSize="10" Text="{Binding Tag}"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock TextWrapping="Wrap" Classes="muted" Text="{Binding Description}" MaxLines="2"/>

                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <TextBlock Text="{Binding QuestionCount, Converter={StaticResource LocFmt}, ConverterParameter=QuestionsFmt}"/>
                                            <TextBlock Text="{Binding DurationMinutes, Converter={StaticResource LocFmt}, ConverterParameter=MinutesFmt}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="8" MinWidth="160">
                                        <TextBlock Grid.Column="1" Classes="muted" HorizontalAlignment="Right" Text="{Binding ProgressPercent, Converter={StaticResource LocFmt}, ConverterParameter=CompletedFmt}"/>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="6" Width="150"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl IsVisible="{Binding !HasNoBanks}" ItemsSource="{Binding ExtraCards}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="card-button" Padding="0" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding $parent[ItemsControl].DataContext.StartExamCommand}"
                                CommandParameter="{Binding .}">
                            <Border Classes="card" Margin="0" MinHeight="160" Padding="20">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                    <Border Width="30" Height="30" Background="{DynamicResource IconBgBrush}" CornerRadius="7"/>

                                    <StackPanel Grid.Column="1" Spacing="10">
                                        <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Title}"/>
                                        <TextBlock TextWrapping="Wrap" Classes="muted" Text="{Binding Description}" MaxLines="2"/>

                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <TextBlock Text="{Binding QuestionCount, Converter={StaticResource LocFmt}, ConverterParameter=QuestionsFmt}"/>
                                            <TextBlock Text="{Binding DurationMinutes, Converter={StaticResource LocFmt}, ConverterParameter=MinutesFmt}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="8" MinWidth="160">
                                        <TextBlock Classes="muted" HorizontalAlignment="Right" Text="{Binding ProgressPercent, Converter={StaticResource LocFmt}, ConverterParameter=CompletedFmt}"/>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="6" Width="150"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
