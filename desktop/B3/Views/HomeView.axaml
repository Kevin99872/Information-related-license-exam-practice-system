<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="B3.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="16">
        <!-- 標題與操作 -->
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
            <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Text="快速模擬"/>
            <TextBlock Grid.Row="1" Classes="muted" Text="選擇您需要的考照類型"/>

            <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="匯入題庫" Classes="ghost"/>
            </StackPanel>
        </Grid>

        <!-- 熱門考照題庫 -->
        <StackPanel Grid.Row="1" Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock FontWeight="Bold" Text="熱門考照題庫"/>
                <TextBlock Classes="muted" Text="熱門題庫卡片即時顯示進度，支援每日自我練習"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding HotCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="320" ItemHeight="170" Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="card-button" Padding="0" Background="Transparent" BorderThickness="0"
                            Command="{Binding $parent[ItemsControl].DataContext.StartExamCommand}"
                                CommandParameter="{Binding .}">
                            <Border Classes="card" Margin="0,0,16,16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="28" Height="28" Background="{StaticResource IconBgBrush}" CornerRadius="6"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Title}"/>
                                        <Border Grid.Column="1" HorizontalAlignment="Right" Padding="6,2" Background="{StaticResource TagBgBrush}" CornerRadius="10">
                                            <TextBlock FontSize="10" Text="{Binding Tag}"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock TextWrapping="Wrap" Classes="muted" Text="{Binding Description}"/>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding QuestionCount, StringFormat='{}{0} 題'}"/>
                                        <TextBlock Text="{Binding DurationMinutes, StringFormat='{}{0} 分鐘'}"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="6"/>
                                        <TextBlock Grid.Column="1" Classes="muted" Margin="8,0,0,0" Text="{Binding ProgressPercent, StringFormat='已完成 {0}%'}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding ExtraCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="320" ItemHeight="170" Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="card-button" Padding="0" Background="Transparent" BorderThickness="0"
                            Command="{Binding $parent[ItemsControl].DataContext.StartExamCommand}"
                                CommandParameter="{Binding .}">
                            <Border Classes="card" Margin="0,0,16,16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="28" Height="28" Background="{StaticResource IconBgBrush}" CornerRadius="6"/>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Title}"/>
                                    </Grid>

                                    <TextBlock TextWrapping="Wrap" Classes="muted" Text="{Binding Description}"/>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding QuestionCount, StringFormat='{}{0} 題'}"/>
                                        <TextBlock Text="{Binding DurationMinutes, StringFormat='{}{0} 分鐘'}"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="6"/>
                                        <TextBlock Grid.Column="1" Classes="muted" Margin="8,0,0,0" Text="{Binding ProgressPercent, StringFormat='已完成 {0}%'}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
