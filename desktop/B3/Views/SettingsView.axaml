<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="B3.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
            <TextBlock FontWeight="Bold" Text="首頁"/>
            <TextBlock Grid.Row="1" Classes="muted" Text="系統設定"/>

            <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="恢復預設" Classes="ghost" Command="{Binding ResetSettingsCommand}"/>
                <Button Content="儲存變更" Classes="primary" Command="{Binding SaveSettingsCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="220,*" ColumnSpacing="24">
            <Border Classes="card" Padding="12">
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" CornerRadius="6">
                                <TextBlock Text="{Binding Title}"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1">
                <!-- 考試設定 -->
                <StackPanel IsVisible="{Binding IsExamSection}" Spacing="16">
                    <TextBlock FontWeight="Bold" Text="考試行為"/>
                    <Border Classes="card">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="作答後立即顯示答案"/>
                                    <TextBlock Classes="muted" Text="不勾選將在最後統一顯示"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowAnswerOnSubmit}"/>
                            </Grid>
                            <Grid Row="1" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="倒數計時器"/>
                                    <TextBlock Classes="muted" Text="考試頁面顯示剩餘時間"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableCountdown}"/>
                            </Grid>
                            <Grid Row="2" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="題目隨機排序"/>
                                    <TextBlock Classes="muted" Text="每次練習重新洗牌題目順序"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShuffleQuestions}"/>
                            </Grid>
                            <Grid Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="每次練習題數"/>
                                    <TextBlock Classes="muted" Text="單次練習的題目數量"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding QuestionsPerExamOptions}"
                                          SelectedItem="{Binding QuestionsPerExam}"
                                          Width="120"/>
                            </Grid>
                            <Grid Row="4" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="難度篩選"/>
                                    <TextBlock Classes="muted" Text="優先出現的題目難易度"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" SelectedItem="{Binding Difficulty}" Width="120">
                                    <x:String>簡單</x:String>
                                    <x:String>中等</x:String>
                                    <x:String>困難</x:String>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 通知 -->
                <StackPanel IsVisible="{Binding IsNotifySection}" Spacing="16">
                    <TextBlock FontWeight="Bold" Text="通知"/>
                    <Border Classes="card">
                        <TextBlock Classes="muted" Text="目前尚無通知設定"/>
                    </Border>
                </StackPanel>

                <!-- 快捷鍵 -->
                <StackPanel IsVisible="{Binding IsKeySection}" Spacing="16">
                    <TextBlock FontWeight="Bold" Text="鍵盤快捷鍵"/>
                    <Border Classes="card">
                        <ItemsControl ItemsSource="{Binding KeyBindings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Action}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Shortcut}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- 資料管理 -->
                <StackPanel IsVisible="{Binding IsDataSection}" Spacing="16">
                    <TextBlock FontWeight="Bold" Text="資料管理"/>
                    <Border Classes="card">
                        <ItemsControl ItemsSource="{Binding DataActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="Bold" Text="{Binding Title}"/>
                                            <TextBlock Classes="muted" Text="{Binding Description}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding ActionLabel}" Classes="ghost"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock FontWeight="Bold" Text="執行環境"/>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" Text="Python 路徑"/>
                                <TextBox Text="{Binding PythonPath}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" Text="C++ 編譯器"/>
                                <TextBox Text="{Binding CppCompilerPath}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" Text="DotNet 路徑"/>
                                <TextBox Text="{Binding DotNetPath}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" Text="預設語言"/>
                                <ComboBox SelectedItem="{Binding DefaultLanguage}" Width="160">
                                    <x:String>Python</x:String>
                                    <x:String>C#</x:String>
                                    <x:String>C++</x:String>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- AI 模型 -->
                <StackPanel IsVisible="{Binding IsAiSection}" Spacing="16">
                    <TextBlock FontWeight="Bold" Text="AI 模型"/>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" Text="Ollama 端點"/>
                                <TextBox Text="{Binding OllamaEndpoint}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" Text="模型名稱"/>
                                <TextBox Text="{Binding OllamaModel}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" Text="使用本地 Transformers 模型"/>
                                <ToggleSwitch IsChecked="{Binding UseLocalTransformers}"/>
                            </StackPanel>
                            <StackPanel Spacing="6" IsVisible="{Binding UseLocalTransformers}">
                                <TextBlock Classes="muted" Text="本地模型路徑/名稱"/>
                                <TextBox Text="{Binding LocalTransformersModelPath}"/>
                            </StackPanel>
                            <TextBlock Classes="muted" Text="儲存後會套用至 AI 問答與程式分析"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 關於 -->
                <StackPanel IsVisible="{Binding IsAboutSection}" Spacing="16">
                    <TextBlock FontWeight="Bold" Text="關於智慧考照"/>
                    <Border Classes="card">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="版本"/>
                                <TextBlock Grid.Column="1" Text="{Binding AppVersion}"/>
                            </Grid>
                            <Grid Row="1" ColumnDefinitions="*,Auto">
                                <TextBlock Text="題庫最後更新"/>
                                <TextBlock Grid.Column="1" Text="{Binding LastSyncDate}"/>
                            </Grid>
                            <Grid Row="2" ColumnDefinitions="*,Auto">
                                <TextBlock Text="檢查更新"/>
                                <Button Grid.Column="1" Content="檢查" Classes="ghost"/>
                            </Grid>
                            <Grid Row="3" ColumnDefinitions="*,Auto">
                                <TextBlock Text="意見回饋"/>
                                <Button Grid.Column="1" Content="回饋" Classes="ghost"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
