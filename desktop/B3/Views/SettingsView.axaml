<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             xmlns:loc="using:B3.Localization"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="B3.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
            <TextBlock FontWeight="Bold" Text="{loc:Loc Home}"/>
            <TextBlock Grid.Row="1" Classes="muted" Text="{loc:Loc SettingsSubtitle}"/>

            <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{loc:Loc RestoreDefaults}" Classes="ghost" Command="{Binding ResetSettingsCommand}"/>
                <Button Content="{loc:Loc SaveChanges}" Classes="primary" Command="{Binding SaveSettingsCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="220,*" ColumnSpacing="24">
            <Border Classes="card" Padding="12">
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" CornerRadius="6">
                                <TextBlock Text="{Binding Title}"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1">
                <!-- 一般設定 -->
                <StackPanel IsVisible="{Binding IsGeneralSection}" Spacing="16">
                    <TextBlock FontWeight="Bold" Text="{loc:Loc GeneralHeader}"/>
                    <Border Classes="card">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Text="{loc:Loc UiLanguageTitle}"/>
                                <TextBlock Classes="muted" Text="{loc:Loc UiLanguageDesc}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding SelectedUiLanguage}"
                                      Width="160"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageOption">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 考試設定 -->
                <StackPanel IsVisible="{Binding IsExamSection}" Spacing="16">
                    <TextBlock FontWeight="Bold" Text="{loc:Loc ExamBehavior}"/>
                    <Border Classes="card">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="{loc:Loc ShowAnswerTitle}"/>
                                    <TextBlock Classes="muted" Text="{loc:Loc ShowAnswerDesc}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowAnswerOnSubmit}"/>
                            </Grid>
                            <Grid Row="1" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="{loc:Loc CountdownTitle}"/>
                                    <TextBlock Classes="muted" Text="{loc:Loc CountdownDesc}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableCountdown}"/>
                            </Grid>
                            <Grid Row="2" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="{loc:Loc ShuffleTitle}"/>
                                    <TextBlock Classes="muted" Text="{loc:Loc ShuffleDesc}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShuffleQuestions}"/>
                            </Grid>
                            <Grid Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="{loc:Loc QuestionsPerExamTitle}"/>
                                    <TextBlock Classes="muted" Text="{loc:Loc QuestionsPerExamDesc}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding QuestionsPerExamOptions}"
                                          SelectedItem="{Binding QuestionsPerExam}"
                                          Width="120"/>
                            </Grid>
                            <Grid Row="4" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="{loc:Loc DifficultyFilterTitle}"/>
                                    <TextBlock Classes="muted" Text="{loc:Loc DifficultyFilterDesc}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" SelectedItem="{Binding Difficulty}" Width="120">
                                    <x:String>簡單</x:String>
                                    <x:String>中等</x:String>
                                    <x:String>困難</x:String>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 通知 已移除 -->

                <!-- 快捷鍵 -->
                <StackPanel IsVisible="{Binding IsKeySection}" Spacing="16">
                    <TextBlock FontWeight="Bold" Text="{loc:Loc KeyboardShortcuts}"/>
                    <Border Classes="card">
                        <ItemsControl ItemsSource="{Binding KeyBindings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Action}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Shortcut}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- 資料管理 -->
                <StackPanel IsVisible="{Binding IsDataSection}" Spacing="16">
                    <TextBlock FontWeight="Bold" Text="{loc:Loc DataManagement}"/>
                    <Border Classes="card">
                        <ItemsControl ItemsSource="{Binding DataActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="Bold" Text="{Binding Title}"/>
                                            <TextBlock Classes="muted" Text="{Binding Description}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding ActionLabel}" Classes="ghost"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock FontWeight="Bold" Text="{loc:Loc RuntimeEnvironment}"/>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" Text="{loc:Loc PythonPath}"/>
                                <TextBox Text="{Binding PythonPath}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" Text="{loc:Loc CppCompiler}"/>
                                <TextBox Text="{Binding CppCompilerPath}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" Text="{loc:Loc DotNetPath}"/>
                                <TextBox Text="{Binding DotNetPath}"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted" Text="{loc:Loc DefaultLanguage}"/>
                                <ComboBox SelectedItem="{Binding DefaultLanguage}" Width="160">
                                    <x:String>Python</x:String>
                                    <x:String>C#</x:String>
                                    <x:String>C++</x:String>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- AI 模型 -->
                <StackPanel IsVisible="{Binding IsAiSection}" Spacing="16">
                    <TextBlock FontWeight="Bold" Text="{loc:Loc AiModel}"/>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="{loc:Loc AiProviderTitle}"/>
                                    <TextBlock Classes="muted" Text="{loc:Loc AiProviderDesc}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AiProviderOptions}"
                                          SelectedItem="{Binding SelectedAiProvider}"
                                          Width="160"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Ollama -->
                            <StackPanel Spacing="12" IsVisible="{Binding IsOllamaProvider}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="muted" Text="{loc:Loc OllamaEndpoint}"/>
                                    <TextBox Text="{Binding OllamaEndpoint}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="muted" Text="{loc:Loc ModelName}"/>
                                    <TextBox Text="{Binding OllamaModel}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="muted" Text="{loc:Loc UseLocalTransformers}"/>
                                    <ToggleSwitch IsChecked="{Binding UseLocalTransformers}"/>
                                </StackPanel>
                                <StackPanel Spacing="6" IsVisible="{Binding UseLocalTransformers}">
                                    <TextBlock Classes="muted" Text="{loc:Loc LocalModelPath}"/>
                                    <TextBox Text="{Binding LocalTransformersModelPath}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- OpenAI -->
                            <StackPanel Spacing="12" IsVisible="{Binding IsOpenAiProvider}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="muted" Text="{loc:Loc OpenAiEndpoint}"/>
                                    <TextBox Text="{Binding OpenAiEndpoint}"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="muted" Text="{loc:Loc ApiKeyLabel}"/>
                                    <TextBox Text="{Binding OpenAiApiKey}"
                                             PasswordChar="●"
                                             Classes="revealPasswordButton"
                                             PlaceholderText="sk-..."/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="muted" Text="{loc:Loc ModelName}"/>
                                    <TextBox Text="{Binding OpenAiModel}" PlaceholderText="gpt-4o-mini"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Claude -->
                            <StackPanel Spacing="12" IsVisible="{Binding IsClaudeProvider}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="muted" Text="{loc:Loc ApiKeyLabel}"/>
                                    <TextBox Text="{Binding ClaudeApiKey}"
                                             PasswordChar="●"
                                             Classes="revealPasswordButton"
                                             PlaceholderText="sk-ant-..."/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="muted" Text="{loc:Loc ModelName}"/>
                                    <TextBox Text="{Binding ClaudeModel}" PlaceholderText="claude-opus-4-8"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Classes="muted" Text="{loc:Loc AiApplyNote}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 關於 -->
                <StackPanel IsVisible="{Binding IsAboutSection}" Spacing="16">
                    <TextBlock FontWeight="Bold" Text="{loc:Loc AboutTitle}"/>
                    <Border Classes="card">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{loc:Loc Version}"/>
                                <TextBlock Grid.Column="1" Text="{Binding AppVersion}"/>
                            </Grid>
                            <Grid Row="1" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{loc:Loc BankLastUpdated}"/>
                                <TextBlock Grid.Column="1" Text="{Binding LastSyncDate}"/>
                            </Grid>
                            <Grid Row="2" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{loc:Loc CheckUpdates}"/>
                                <Button Grid.Column="1" Content="{loc:Loc Check}" Classes="ghost"/>
                            </Grid>
                            <Grid Row="3" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{loc:Loc Feedback}"/>
                                <Button Grid.Column="1" Content="{loc:Loc FeedbackAction}" Classes="ghost"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
