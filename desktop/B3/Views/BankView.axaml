<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Name="Root"
             x:Class="B3.Views.BankView"
             x:DataType="vm:BankViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="20" Margin="0,6,0,6">
        <!-- 搜尋與操作 -->
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="14">
            <TextBlock Text="搜尋題庫名稱..." Classes="muted"/>
            <TextBox Grid.Row="1" Width="260" PlaceholderText="搜尋題庫名稱..."/>

            <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="同步更新" Classes="ghost" Command="{Binding RefreshCommand}"/>
                <Button Content="新增題庫" Classes="primary" Command="{Binding ImportTqcCommand}"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Classes="muted" Text="{Binding StatusMessage}"/>

        <!-- 統計區塊 -->
        <UniformGrid Grid.Row="2" Columns="4" Rows="1" HorizontalAlignment="Stretch">
            <Border Classes="card" Margin="0,0,12,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="已載入題庫" Classes="muted"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding LoadedBankCount}"/>
                </StackPanel>
            </Border>
            <Border Classes="card" Margin="0,0,12,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="題目總數" Classes="muted"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding TotalQuestionCount}"/>
                </StackPanel>
            </Border>
            <Border Classes="card" Margin="0,0,12,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="已作答題數" Classes="muted"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding AnsweredQuestionCount}"/>
                </StackPanel>
            </Border>
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Text="整體正確率" Classes="muted"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding AccuracyPercent, StringFormat='{}{0}%'}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 題庫列表 -->
        <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                    <TextBlock FontWeight="Bold" Text="官方題庫"/>
                    <TextBlock Classes="muted" Text="點選題庫卡片可展開內部題目列表。"/>
                    <ItemsControl ItemsSource="{Binding OfficialBanks}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,14" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <Border Classes="card" Padding="18" HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource IconBgBrush}"/>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock FontWeight="Bold" Text="{Binding Title}"/>
                                                        <Border Padding="6,2" Background="{StaticResource TagBgBrush}" CornerRadius="10">
                                                            <TextBlock FontSize="10" Text="{Binding Status}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Classes="muted" Text="{Binding QuestionCount, StringFormat='{}{0} 題'}"/>
                                                        <TextBlock Classes="muted" Text="|"/>
                                                        <TextBlock Classes="muted" Text="{Binding UpdatedDate, StringFormat='更新於 {0}'}"/>
                                                        <TextBlock Classes="muted" Text="|"/>
                                                        <TextBlock Classes="muted" Text="{Binding Source}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="6">
                                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Width="140" Height="6"/>
                                                    <TextBlock Classes="muted" HorizontalAlignment="Right" Text="{Binding ProgressPercent, StringFormat='{}{0}% 完成'}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Expander.Header>

                                    <Border Classes="card" Margin="0,10,0,0" Padding="16" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                                            <TextBlock FontWeight="Bold" Text="內部題目列表"/>
                                            <ItemsControl ItemsSource="{Binding Problems}" HorizontalAlignment="Stretch">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="list-item" Padding="14" Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock FontWeight="Bold" Text="{Binding ProblemCode}"/>
                                                                    <TextBlock Classes="muted" Text="{Binding CreatedAt, StringFormat=新增日期：{0:yyyy-MM-dd HH:mm}}"/>
                                                                </StackPanel>

                                                                <Button Grid.Column="1" Content="修改" Command="{Binding DataContext.EditProblemCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                                <Button Grid.Column="2" Content="刪除" Classes="danger" Command="{Binding DataContext.DeleteProblemCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                    <TextBlock FontWeight="Bold" Text="自訂題庫"/>
                    <ItemsControl ItemsSource="{Binding CustomBanks}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,14" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <Border Classes="card" Padding="18" HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource IconBgBrush}"/>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock FontWeight="Bold" Text="{Binding Title}"/>
                                                        <Border Padding="6,2" Background="{StaticResource TagAltBgBrush}" CornerRadius="10">
                                                            <TextBlock FontSize="10" Text="{Binding Status}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Classes="muted" Text="{Binding QuestionCount, StringFormat='{}{0} 題'}"/>
                                                        <TextBlock Classes="muted" Text="|"/>
                                                        <TextBlock Classes="muted" Text="{Binding UpdatedDate, StringFormat='更新於 {0}'}"/>
                                                        <TextBlock Classes="muted" Text="|"/>
                                                        <TextBlock Classes="muted" Text="{Binding Source}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="6">
                                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Width="140" Height="6"/>
                                                    <TextBlock Classes="muted" HorizontalAlignment="Right" Text="{Binding ProgressPercent, StringFormat='{}{0}% 完成'}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Expander.Header>

                                    <Border Classes="card" Margin="0,10,0,0" Padding="16" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                                            <TextBlock FontWeight="Bold" Text="內部題目列表"/>
                                            <TextBlock Classes="muted" Text="目前尚未綁定自訂題庫資料。"/>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
