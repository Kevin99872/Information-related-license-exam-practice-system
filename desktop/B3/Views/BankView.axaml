<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             xmlns:loc="using:B3.Localization"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Name="Root"
             x:Class="B3.Views.BankView"
             x:DataType="vm:BankViewModel">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <!-- 標題、搜尋與操作 -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Spacing="4">
                <TextBlock Classes="page-title" Text="{loc:Loc LoadedBanks}"/>
                <TextBlock Classes="muted" Text="{Binding StatusMessage}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox Width="240" Text="{Binding SearchKeyword}" PlaceholderText="{loc:Loc SearchBankName}" VerticalAlignment="Center"/>
                <Button Content="{loc:Loc SyncUpdate}" Classes="ghost" Command="{Binding RefreshCommand}"/>
                <Button Content="{loc:Loc AddBank}" Classes="primary" Command="{Binding ImportTqcCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 統計區塊 -->
        <UniformGrid Grid.Row="1" Columns="4" Rows="1" HorizontalAlignment="Stretch">
            <Border Classes="panel" Margin="0,0,12,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc LoadedBanks}" Classes="muted"/>
                    <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding LoadedBankCount}"/>
                </StackPanel>
            </Border>
            <Border Classes="panel" Margin="0,0,12,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc TotalQuestions}" Classes="muted"/>
                    <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding TotalQuestionCount}"/>
                </StackPanel>
            </Border>
            <Border Classes="panel" Margin="0,0,12,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc AnsweredQuestions}" Classes="muted"/>
                    <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding AnsweredQuestionCount}"/>
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc OverallAccuracy}" Classes="muted"/>
                    <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding AccuracyPercent, StringFormat='{}{0}%'}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 題庫列表 -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                    <TextBlock Classes="section-title" Text="{loc:Loc OfficialBanks}"/>
                    <TextBlock Classes="muted" Text="{loc:Loc OfficialBanksDesc}"/>
                    <ItemsControl ItemsSource="{Binding OfficialBanks}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Border Padding="6,10" HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource IconBgBrush}">
                                                    <Path Data="M8 1 1 4.5 8 8l7-3.5zM1 8l7 3.5L15 8v2.2l-7 3.5-7-3.5z" Width="16" Height="16" Stretch="Uniform"
                                                          Fill="{DynamicResource PrimaryBrush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock FontWeight="Bold" Text="{Binding Title}"/>
                                                        <Border Padding="6,2" Background="{DynamicResource TagBgBrush}" CornerRadius="10">
                                                            <TextBlock FontSize="10" Text="{Binding Status}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Classes="muted" Text="{Binding QuestionCount, Converter={StaticResource LocFmt}, ConverterParameter=QuestionsFmt}"/>
                                                        <TextBlock Classes="muted" Text="|"/>
                                                        <TextBlock Classes="muted" Text="{Binding UpdatedDate, Converter={StaticResource LocFmt}, ConverterParameter=UpdatedFmt}"/>
                                                        <TextBlock Classes="muted" Text="|"/>
                                                        <TextBlock Classes="muted" Text="{Binding Source}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Width="140" Height="6"/>
                                                    <TextBlock Classes="muted" HorizontalAlignment="Right" Text="{Binding ProgressPercent, Converter={StaticResource LocFmt}, ConverterParameter=PercentDoneFmt}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Expander.Header>

                                    <Border Padding="4" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                                            <TextBlock FontWeight="Bold" Text="{loc:Loc InnerProblemList}"/>
                                            <ItemsControl ItemsSource="{Binding Problems}" HorizontalAlignment="Stretch">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="subpanel" Padding="14,10" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock FontWeight="Bold" Text="{Binding ProblemCode}"/>
                                                                    <TextBlock Classes="muted" Text="{Binding CreatedAt, Converter={StaticResource LocFmt}, ConverterParameter=CreatedAtFmt}"/>
                                                                </StackPanel>

                                                                <Button Grid.Column="1" Content="{loc:Loc Edit}" Classes="ghost" Command="{Binding DataContext.EditProblemCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                                <Button Grid.Column="2" Content="{loc:Loc Delete}" Classes="danger" Command="{Binding DataContext.DeleteProblemCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                    <TextBlock Classes="section-title" Text="{loc:Loc CustomBanks}"/>
                    <TextBlock Classes="muted" Text="{loc:Loc CustomBanksEmpty}" IsVisible="{Binding !CustomBanks.Count}"/>
                    <ItemsControl ItemsSource="{Binding CustomBanks}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Border Padding="6,10" HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource IconBgBrush}">
                                                    <Path Data="M8 1 1 4.5 8 8l7-3.5zM1 8l7 3.5L15 8v2.2l-7 3.5-7-3.5z" Width="16" Height="16" Stretch="Uniform"
                                                          Fill="{DynamicResource PrimaryBrush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock FontWeight="Bold" Text="{Binding Title}"/>
                                                        <Border Padding="6,2" Background="{DynamicResource TagAltBgBrush}" CornerRadius="10">
                                                            <TextBlock FontSize="10" Text="{Binding Status}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Classes="muted" Text="{Binding QuestionCount, Converter={StaticResource LocFmt}, ConverterParameter=QuestionsFmt}"/>
                                                        <TextBlock Classes="muted" Text="|"/>
                                                        <TextBlock Classes="muted" Text="{Binding UpdatedDate, Converter={StaticResource LocFmt}, ConverterParameter=UpdatedFmt}"/>
                                                        <TextBlock Classes="muted" Text="|"/>
                                                        <TextBlock Classes="muted" Text="{Binding Source}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Width="140" Height="6"/>
                                                    <TextBlock Classes="muted" HorizontalAlignment="Right" Text="{Binding ProgressPercent, Converter={StaticResource LocFmt}, ConverterParameter=PercentDoneFmt}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Expander.Header>

                                    <Border Padding="4" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                                            <TextBlock FontWeight="Bold" Text="{loc:Loc InnerProblemList}"/>
                                            <TextBlock Classes="muted" Text="{loc:Loc CustomBanksEmpty}"/>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
