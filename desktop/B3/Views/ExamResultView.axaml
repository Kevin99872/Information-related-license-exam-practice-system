<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             xmlns:loc="using:B3.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="B3.Views.ExamResultView"
             x:DataType="vm:ExamResultViewModel">

    <UserControl.Styles>
        <Style Selector="Border.result-card">
            <Setter Property="Background" Value="#101821"/>
            <Setter Property="BorderBrush" Value="#24334B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style Selector="TextBlock.exam-title">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBox.exam-output">
            <Setter Property="Background" Value="#101923"/>
            <Setter Property="BorderBrush" Value="#2A3A53"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,monospace"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="result-card">
        <Grid ColumnDefinitions="1*,0.9*" ColumnSpacing="12">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc ExamResult}" Classes="exam-title" FontSize="18"/>
                <TextBlock Text="{Binding ScoreGrade, Converter={StaticResource LocFmt}, ConverterParameter=GradeFmt}" FontSize="16" FontWeight="Bold" Foreground="#FFC266"/>
                <TextBlock Text="{Binding CorrectCount, Converter={StaticResource LocFmt}, ConverterParameter=CorrectFmt}"/>
                <TextBlock Text="{Binding AnsweredCount, Converter={StaticResource LocFmt}, ConverterParameter=AnsweredFmt}"/>
                <TextBlock Text="{Binding TotalProblems, Converter={StaticResource LocFmt}, ConverterParameter=TotalBankFmt}"/>
                <TextBlock Text="{Binding ElapsedTimeText, Converter={StaticResource LocFmt}, ConverterParameter=ElapsedFmt}"/>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ScorePercent}" Height="8"/>
                <TextBlock Classes="muted" Text="{Binding ScorePercent, Converter={StaticResource LocFmt}, ConverterParameter=AccuracyFmt}"/>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="{loc:Loc ReturnHome}" Classes="primary" Command="{Binding ReturnHomeCommand}"/>
                </StackPanel>

                <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                    <Border Background="#0D1117" CornerRadius="8" BorderBrush="#24334B" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Loc ThisExamProblems}" Classes="exam-title" FontSize="14"/>
                            <ListBox ItemsSource="{Binding ExamProblems}" SelectedItem="{Binding SelectedExamProblem}" Height="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProblemCode, StringFormat='[{0}]'}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Title}" FontSize="12" Classes="muted"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBox Text="{Binding SelectedExamProblem.Description}" AcceptsReturn="True" Height="120" IsReadOnly="True" Classes="exam-output"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#0D1117" CornerRadius="8" BorderBrush="#24334B" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Loc SubmissionLog}" Classes="exam-title" FontSize="14"/>
                            <ListBox ItemsSource="{Binding ExamSubmissions}" SelectedItem="{Binding SelectedSubmission}" Height="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SubmittedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" FontSize="12" Classes="muted"/>
                                            <TextBlock Text="{Binding Problem.ProblemCode, Converter={StaticResource LocFmt}, ConverterParameter=ProblemFmt}"/>
                                            <TextBlock Text="{Binding IsCorrect, Converter={StaticResource LocFmt}, ConverterParameter=IsCorrectFmt}" Classes="muted" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid ColumnDefinitions="1*,1*" RowSpacing="6">
                                <TextBox Text="{Binding SelectedSubmission.UserCode}" AcceptsReturn="True" Height="120" IsReadOnly="True" Classes="exam-output" Grid.Column="0"/>
                                <TextBox Text="{Binding SelectedSubmission.Problem.Description}" AcceptsReturn="True" Height="120" IsReadOnly="True" Classes="exam-output" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="10">
                <Border Background="#0D1117" CornerRadius="8" BorderBrush="#24334B" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Loc AiQa}" Classes="exam-title" FontSize="14"/>
                        <TextBox Text="{Binding AiQuestion}" AcceptsReturn="True" Height="70" Classes="exam-output" PlaceholderText="{loc:Loc AiQuestionPlaceholder}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{loc:Loc SendQuestion}" Classes="primary" Command="{Binding AskAiCommand}" IsEnabled="{Binding IsAiNotBusy}"/>
                            <Button Content="{loc:Loc AnalyzeCode}" Classes="ghost" Command="{Binding AnalyzeCodeCommand}" IsEnabled="{Binding IsAiNotBusy}"/>
                        </StackPanel>
                        <TextBox Text="{Binding AiAnswer}" AcceptsReturn="True" Height="110" IsReadOnly="True" Classes="exam-output" PlaceholderText="{loc:Loc AiAnswer}"/>
                        <TextBox Text="{Binding AiAnalysis}" AcceptsReturn="True" Height="110" IsReadOnly="True" Classes="exam-output" PlaceholderText="{loc:Loc AiAnalysis}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
