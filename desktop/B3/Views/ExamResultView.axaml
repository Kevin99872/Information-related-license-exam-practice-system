<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             xmlns:loc="using:B3.Localization"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             x:Class="B3.Views.ExamResultView"
             x:DataType="vm:ExamResultViewModel">

    <UserControl.Styles>
        <!-- 統計數字方塊 -->
        <Style Selector="Border.stat">
            <Setter Property="Background" Value="{DynamicResource SoftPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinWidth" Value="104"/>
        </Style>
        <Style Selector="Border.stat TextBlock.value">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.ok">
            <Setter Property="Foreground" Value="#3FB950"/>
        </Style>
        <Style Selector="TextBlock.fail">
            <Setter Property="Foreground" Value="#E5534B"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <!-- 成績摘要 -->
        <Border Classes="panel" Padding="20,16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="24">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc ExamResult}" Classes="muted"/>
                    <TextBlock Text="{Binding ScoreGrade}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding ScorePercent, Converter={StaticResource LocFmt}, ConverterParameter=AccuracyFmt}"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ScorePercent}" Height="6" MinHeight="6" Width="180" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Classes="stat">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc StatCorrect}" Classes="muted" FontSize="12"/>
                            <TextBlock Classes="value" Text="{Binding CorrectCount}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="stat">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc StatAnswered}" Classes="muted" FontSize="12"/>
                            <TextBlock Classes="value" Text="{Binding AnsweredCount}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="stat">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc StatTotal}" Classes="muted" FontSize="12"/>
                            <TextBlock Classes="value" Text="{Binding TotalProblems}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="stat">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Loc StatTime}" Classes="muted" FontSize="12"/>
                            <TextBlock Classes="value" Text="{Binding ElapsedTimeText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Column="2" Content="{loc:Loc ReturnHome}" Classes="primary" Height="38" VerticalAlignment="Center"
                        VerticalContentAlignment="Center" Command="{Binding ReturnHomeCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="300,12,*,12,340">
            <!-- 左：提交記錄 / 本次考題 -->
            <Grid RowDefinitions="*,12,*">
                <Border Classes="panel" Padding="12">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Text="{loc:Loc SubmissionLog}" Classes="section-title" Margin="4,0"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding ExamSubmissions}" SelectedItem="{Binding SelectedSubmission}"
                                 Background="Transparent" BorderThickness="0" Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,2">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Problem.ProblemCode}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SubmittedAt, StringFormat='{}{0:HH:mm:ss}'}" FontSize="12" Classes="muted"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Classes="ok" Text="{loc:Loc ResultCorrect}" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" IsVisible="{Binding IsCorrect}"/>
                                        <TextBlock Grid.Column="1" Classes="fail" Text="{loc:Loc ResultWrong}" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" IsVisible="{Binding !IsCorrect}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="1" Text="{loc:Loc NoSubmission}" Classes="muted" TextWrapping="Wrap" Margin="4,4"
                                   IsVisible="{Binding !ExamSubmissions.Count}"/>
                    </Grid>
                </Border>

                <Border Classes="panel" Padding="12" Grid.Row="2">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Text="{loc:Loc ThisExamProblems}" Classes="section-title" Margin="4,0"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding ExamProblems}" SelectedItem="{Binding SelectedExamProblem}"
                                 Background="Transparent" BorderThickness="0" Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="4,2">
                                        <TextBlock Text="{Binding ProblemCode}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Title}" FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- 中：選取提交的程式碼與判題輸出 / 選取考題的敘述 -->
            <Grid Grid.Column="2" RowDefinitions="3*,12,2*">
                <Border Classes="panel">
                    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="12">
                        <TextBlock Text="{loc:Loc YourCode}" Classes="section-title"/>
                        <TextBlock Grid.Column="1" Text="{loc:Loc JudgeOutput}" Classes="section-title"/>

                        <Border Grid.Row="1" Classes="code-well">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <SelectableTextBlock Classes="mono" Text="{Binding SelectedSubmission.UserCode}" Foreground="#D4D9E1"
                                                     LineHeight="20" Margin="12,10"/>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Classes="code-well">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <SelectableTextBlock Classes="mono" Text="{Binding SelectedSubmission.OutputResult}" Foreground="#D4D9E1"
                                                     TextWrapping="Wrap" LineHeight="20" Margin="12,10"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" ResizeDirection="Rows" HorizontalAlignment="Stretch"/>

                <Border Classes="panel" Grid.Row="2">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Classes="tag accent"
                                    IsVisible="{Binding SelectedExamProblem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding SelectedExamProblem.ProblemCode}"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedExamProblem.Title}" Classes="section-title"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <SelectableTextBlock Text="{Binding SelectedExamProblem.Description}" TextWrapping="Wrap" LineHeight="23" Margin="0,0,10,0"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右：AI 問答 -->
            <Border Grid.Column="4" Classes="panel">
                <Grid RowDefinitions="Auto,Auto,Auto,*,*" RowSpacing="10">
                    <TextBlock Text="{loc:Loc AiQa}" Classes="section-title"/>
                    <TextBox Grid.Row="1" Text="{Binding AiQuestion}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                             PlaceholderText="{loc:Loc AiQuestionPlaceholder}"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="{loc:Loc SendQuestion}" Classes="primary" Command="{Binding AskAiCommand}" IsEnabled="{Binding IsAiNotBusy}"/>
                        <Button Content="{loc:Loc AnalyzeCode}" Classes="ghost" Command="{Binding AnalyzeCodeCommand}" IsEnabled="{Binding IsAiNotBusy}"/>
                        <ProgressBar IsIndeterminate="True" Width="60" Height="4" MinHeight="4" VerticalAlignment="Center" IsVisible="{Binding IsAiBusy}"/>
                    </StackPanel>
                    <TextBox Grid.Row="3" Text="{Binding AiAnswer}" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                             VerticalContentAlignment="Top" PlaceholderText="{loc:Loc AiAnswer}"/>
                    <TextBox Grid.Row="4" Text="{Binding AiAnalysis}" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                             VerticalContentAlignment="Top" PlaceholderText="{loc:Loc AiAnalysis}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</UserControl>
