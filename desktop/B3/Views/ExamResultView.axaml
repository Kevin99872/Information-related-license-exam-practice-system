<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="B3.Views.ExamResultView"
             x:DataType="vm:ExamResultViewModel">

    <UserControl.Styles>
        <Style Selector="Border.result-card">
            <Setter Property="Background" Value="#101821"/>
            <Setter Property="BorderBrush" Value="#24334B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style Selector="TextBlock.exam-title">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBox.exam-output">
            <Setter Property="Background" Value="#101923"/>
            <Setter Property="BorderBrush" Value="#2A3A53"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,monospace"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="result-card">
        <Grid ColumnDefinitions="1*,0.9*" ColumnSpacing="12">
            <StackPanel Spacing="10">
                <TextBlock Text="考試結算" Classes="exam-title" FontSize="18"/>
                <TextBlock Text="{Binding ScoreGrade, StringFormat='等級：{0}'}" FontSize="16" FontWeight="Bold" Foreground="#FFC266"/>
                <TextBlock Text="{Binding CorrectCount, StringFormat='答對：{0} 題'}"/>
                <TextBlock Text="{Binding AnsweredCount, StringFormat='作答：{0} 題'}"/>
                <TextBlock Text="{Binding TotalProblems, StringFormat='題庫總題數：{0} 題'}"/>
                <TextBlock Text="{Binding ElapsedTimeText, StringFormat='花費時間：{0}'}"/>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ScorePercent}" Height="8"/>
                <TextBlock Classes="muted" Text="{Binding ScorePercent, StringFormat='答對率 {0}%'}"/>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="返回首頁" Classes="primary" Command="{Binding ReturnHomeCommand}"/>
                </StackPanel>

                <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                    <Border Background="#0D1117" CornerRadius="8" BorderBrush="#24334B" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="本次考題" Classes="exam-title" FontSize="14"/>
                            <ListBox ItemsSource="{Binding ExamProblems}" SelectedItem="{Binding SelectedExamProblem}" Height="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProblemCode, StringFormat='[{0}]'}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Title}" FontSize="12" Classes="muted"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBox Text="{Binding SelectedExamProblem.Description}" AcceptsReturn="True" Height="120" IsReadOnly="True" Classes="exam-output"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#0D1117" CornerRadius="8" BorderBrush="#24334B" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="提交記錄" Classes="exam-title" FontSize="14"/>
                            <ListBox ItemsSource="{Binding ExamSubmissions}" SelectedItem="{Binding SelectedSubmission}" Height="180">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SubmittedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" FontSize="12" Classes="muted"/>
                                            <TextBlock Text="{Binding Problem.ProblemCode, StringFormat='題目：{0}'}"/>
                                            <TextBlock Text="{Binding IsCorrect, StringFormat='是否正確：{0}'}" Classes="muted" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBox Text="{Binding SelectedSubmission.UserCode}" AcceptsReturn="True" Height="120" IsReadOnly="True" Classes="exam-output"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="10">
                <Border Background="#0D1117" CornerRadius="8" BorderBrush="#24334B" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="AI 問答" Classes="exam-title" FontSize="14"/>
                        <TextBox Text="{Binding AiQuestion}" AcceptsReturn="True" Height="70" Classes="exam-output" PlaceholderText="輸入想詢問的題目或程式碼觀念"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="送出問題" Classes="primary" Command="{Binding AskAiCommand}" IsEnabled="{Binding IsAiNotBusy}"/>
                            <Button Content="分析程式" Classes="ghost" Command="{Binding AnalyzeCodeCommand}" IsEnabled="{Binding IsAiNotBusy}"/>
                        </StackPanel>
                        <TextBox Text="{Binding AiAnswer}" AcceptsReturn="True" Height="110" IsReadOnly="True" Classes="exam-output" PlaceholderText="AI 回答"/>
                        <TextBox Text="{Binding AiAnalysis}" AcceptsReturn="True" Height="110" IsReadOnly="True" Classes="exam-output" PlaceholderText="AI 程式分析"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
