<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             xmlns:loc="using:B3.Localization"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="B3.Views.StyleView"
             x:DataType="vm:StyleViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
            <TextBlock FontWeight="Bold" Text="{loc:Loc Home}"/>
            <TextBlock Grid.Row="1" Classes="muted" Text="{loc:Loc StyleSubtitle}"/>

            <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{loc:Loc RestoreDefaults}" Classes="ghost" Name="RestoreButton" Click="OnRestoreClicked"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="20">
            <StackPanel Spacing="16">
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock FontWeight="Bold" Text="{loc:Loc UiTheme}"/>
                        <ListBox ItemsSource="{Binding Themes, Mode=OneWay}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Height="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="300" Height="32" CornerRadius="6" Background="{DynamicResource SoftPanelBrush}" Padding="8">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock FontWeight="Bold" Text="{loc:Loc FontAndSize}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{loc:Loc UiFont}"/>
                            <ComboBox Width="260" SelectedItem="{Binding FontFamily, Mode=TwoWay}">
                                <x:String>Segoe UI Variable Text, Microsoft JhengHei UI, Noto Sans TC</x:String>
                                <x:String>Segoe UI Variable Text, Noto Sans TC</x:String>
                                <x:String>Microsoft JhengHei UI, Noto Sans TC</x:String>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{loc:Loc FontSize}"/>
                            <NumericUpDown Width="120" Minimum="10" Maximum="20" Value="{Binding FontSize, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock FontWeight="Bold" Text="{loc:Loc OtherOptions}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{loc:Loc ShowProgressBar}"/>
                            <ToggleSwitch IsChecked="{Binding ShowProgress, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Classes="card" Grid.Column="1">
                <StackPanel Spacing="12">
                    <TextBlock FontWeight="Bold" Text="{loc:Loc LivePreview}"/>
                    <Border Background="{DynamicResource SoftPanelBrush}" CornerRadius="10" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource IconBgBrush}"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold" Text="TQC+Python"/>
                                <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource TagBgBrush}" Padding="6,2" CornerRadius="10">
                                    <TextBlock FontSize="10" Text="{loc:Loc TagRecommended}"/>
                                </Border>
                            </Grid>
                            <TextBlock Classes="muted" Text="{loc:Loc PreviewSampleDesc}"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="1,240 題"/>
                                <TextBlock Text="180 分鐘"/>
                            </StackPanel>
                            <ProgressBar Minimum="0" Maximum="100" Value="34" Height="6"/>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="muted" Text="{loc:Loc CurrentSummary}"/>
                                <TextBlock Text="{Binding SelectedTheme.Name, Converter={StaticResource LocFmt}, ConverterParameter=ThemeFmt}"/>
                                <TextBlock Text="{Binding FontFamily, Converter={StaticResource LocFmt}, ConverterParameter=FontFmt}"/>
                                <TextBlock Text="{Binding FontSize, Converter={StaticResource LocFmt}, ConverterParameter=FontSizeFmt}"/>
                                <TextBlock Text="{Binding ShowProgress, Converter={StaticResource LocFmt}, ConverterParameter=ShowProgressFmt}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="{DynamicResource TagBgBrush}" Padding="8,4" CornerRadius="14">
                            <TextBlock FontSize="10" Text="{loc:Loc TagHot}"/>
                        </Border>
                        <Border Background="{DynamicResource TagBgBrush}" Padding="8,4" CornerRadius="14">
                            <TextBlock FontSize="10" Text="{loc:Loc TagRecommended}"/>
                        </Border>
                        <Border Background="{DynamicResource TagBgBrush}" Padding="8,4" CornerRadius="14">
                            <TextBlock FontSize="10" Text="{loc:Loc TagNew}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
