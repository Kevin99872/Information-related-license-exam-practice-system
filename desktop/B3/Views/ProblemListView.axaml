<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="B3.Views.ProblemListView"
             x:DataType="vm:ProblemListViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- 篩選工具欄 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Background="#F9F9F9">
            <TextBlock Text="考照類型:" VerticalAlignment="Center"/>
            <ComboBox SelectedItem="{Binding SelectedExamType}" Width="120">
                <x:String>All</x:String>
                <x:String>TQC</x:String>
                <x:String>CPE</x:String>
                <x:String>Leetcode</x:String>
            </ComboBox>

            <TextBlock Text="狀態:" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <ComboBox SelectedItem="{Binding SelectedStatus}" Width="120">
                <x:String>All</x:String>
                <x:String>Active</x:String>
                <x:String>Draft</x:String>
                <x:String>Archived</x:String>
            </ComboBox>

            <TextBlock Text="搜尋:" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBox Text="{Binding SearchKeyword}" PlaceholderText="輸入題目代碼或標題..." Width="200"/>
        </StackPanel>

        <!-- 題目列表 -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Problems}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0,0,0,1" BorderBrush="#DDD" Background="#FFF">
                        <Grid ColumnDefinitions="100,200,100,80,80,100">
                            <TextBlock Grid.Column="0" Text="{Binding ProblemCode}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}"/>
                            <TextBlock Grid.Column="2" Text="{Binding ExamType}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Difficulty}"/>
                            <TextBlock Grid.Column="4" Text="{Binding Status}"/>
                            <TextBlock Grid.Column="5" Text="{Binding TestCases.Count}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

</UserControl>
