<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             xmlns:models="using:B3.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Name="Root"
             x:CompileBindings="False"
             x:Class="B3.Views.ImportView"
             >

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="4">
            <Border Classes="card" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="18" FontWeight="Bold" Text="匯入題庫"/>
                    <TextBlock Classes="muted" Text="支援單題手動新增，以及 CSV / XLS / XLSX 表單匯入。"/>
                    <TextBlock Classes="muted" Text="{Binding SupportedFormats, StringFormat=支援格式：{0}}"/>
                    <TextBlock Classes="muted" Text="{Binding ImportStatusMessage}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TabControl>
                <TabItem Header="單題新增">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="4">
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock FontWeight="Bold" Text="題目基本資料"/>
                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="muted" Text="題目代碼"/>
                                            <TextBox Text="{Binding SingleProblemCode}" PlaceholderText="例如：PYD101"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Classes="muted" Text="考照種類"/>
                                            <TextBox Text="{Binding SingleExamType}" PlaceholderText="TQC / CPE / Leetcode"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <TextBlock Classes="muted" Text="難度"/>
                                            <TextBox Text="{Binding SingleDifficulty}" PlaceholderText="1 / 2 / 3"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Spacing="6">
                                            <TextBlock Classes="muted" Text="題目標題"/>
                                            <TextBox Text="{Binding SingleTitle}" PlaceholderText="標題"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                            <TextBlock Classes="muted" Text="狀態"/>
                                            <TextBox Text="{Binding SingleStatus}" PlaceholderText="Draft / Active"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6">
                                            <TextBlock Classes="muted" Text="解法語言"/>
                                            <TextBox Text="{Binding SingleSolutionLanguage}" PlaceholderText="Python / C# / C++"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Spacing="6">
                                            <TextBlock Classes="muted" Text="題目敘述"/>
                                            <TextBox Text="{Binding SingleDescription}" AcceptsReturn="True" AcceptsTab="True" MinHeight="120" TextWrapping="Wrap" PlaceholderText="請輸入題目敘述"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock FontWeight="Bold" Text="解法內容"/>
                                    <TextBox Text="{Binding SingleSolutionCode}" AcceptsReturn="True" AcceptsTab="True" MinHeight="160" TextWrapping="Wrap" PlaceholderText="貼上解法程式碼"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock FontWeight="Bold" VerticalAlignment="Center" Text="測試資料與驗證資料"/>
                                        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding SingleTestCases.Count, StringFormat=共 {0} 筆}"/>
                                        <Button Content="新增一筆" Command="{Binding AddSingleTestCaseCommand}"/>
                                        <Button Content="重設" Classes="ghost" Command="{Binding ResetSingleFormCommand}"/>
                                        <Button Content="匯入 / 更新" Classes="primary" Command="{Binding ImportSingleProblemCommand}"/>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding SingleTestCases}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="list-item" Padding="12" Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="80,*,*,90,110" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Classes="muted" Text="順序"/>
                                                            <TextBox Text="{Binding OrderIndex}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Spacing="6">
                                                            <TextBlock Classes="muted" Text="測試資料"/>
                                                            <TextBox Text="{Binding Input}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" PlaceholderText="輸入資料"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Spacing="6">
                                                            <TextBlock Classes="muted" Text="驗證資料"/>
                                                            <TextBox Text="{Binding ExpectedOutput}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" PlaceholderText="期望輸出"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Spacing="6">
                                                            <TextBlock Classes="muted" Text="範例"/>
                                                            <CheckBox IsChecked="{Binding IsExample}" Content="顯示"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="4" Grid.RowSpan="2" Content="移除" Classes="ghost" HorizontalAlignment="Stretch" Command="{Binding DataContext.RemoveSingleTestCaseCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="表單匯入">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="4">
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock FontWeight="Bold" Text="檔案匯入與模板"/>
                                    <TextBlock Classes="muted" Text="每一列代表一筆測試資料，相同 ProblemCode 的列會合併成同一題。" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="選擇 CSV / XLS / XLSX" Classes="primary" Click="OnPickSpreadsheetClicked"/>
                                        <Button Content="預覽 / 驗證" Click="OnPreviewSpreadsheetClicked"/>
                                        <Button Content="匯入 / 更新" Classes="primary" Click="OnImportSpreadsheetClicked"/>
                                        <Button Content="下載模板" Classes="ghost" Click="OnDownloadTemplateClicked"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding SpreadsheetFilePath}" IsReadOnly="True" PlaceholderText="尚未選擇檔案"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="Bold" Text="模板規格"/>
                                    <TextBlock Classes="muted" Text="{Binding TemplateSpecification}" TextWrapping="Wrap"/>
                                    <TextBlock Classes="muted" Text="{Binding TemplateNotes}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock FontWeight="Bold" Text="預覽結果"/>
                                    <ItemsControl ItemsSource="{Binding PreviewRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="list-item" Padding="10" Margin="0,0,0,8">
                                                    <StackPanel Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock FontWeight="Bold" Text="{Binding ProblemCode}"/>
                                                            <TextBlock Classes="muted" Text="{Binding Title}"/>
                                                            <TextBlock Classes="muted" Text="{Binding RowNumber, StringFormat=第 {0} 列}"/>
                                                            <TextBlock Text="{Binding IsValid, StringFormat=Valid: {0}}"/>
                                                        </StackPanel>
                                                        <TextBlock Classes="muted" Text="{Binding ValidationMessage}" TextWrapping="Wrap"/>
                                                        <TextBlock Classes="muted" Text="{Binding TestInput, StringFormat=測試資料：{0}}" TextWrapping="Wrap"/>
                                                        <TextBlock Classes="muted" Text="{Binding ExpectedOutput, StringFormat=驗證資料：{0}}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock FontWeight="Bold" Text="驗證訊息"/>
                                    <ItemsControl ItemsSource="{Binding ValidationIssues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="muted" Padding="8" CornerRadius="8" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding RowNumber, StringFormat=第 {0} 列}" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Field, StringFormat=欄位：{0}}"/>
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
