<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             xmlns:models="using:B3.Models"
             xmlns:loc="using:B3.Localization"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
             x:Name="Root"
             x:CompileBindings="False"
             x:Class="B3.Views.ImportView"
             >

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="4">
            <Border Classes="card" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="18" FontWeight="Bold" Text="{loc:Loc ImportBankTitle}"/>
                    <TextBlock Classes="muted" Text="{loc:Loc ImportDesc}"/>
                    <TextBlock Classes="muted" Text="{Binding SupportedFormats, Converter={StaticResource LocFmt}, ConverterParameter=SupportedFmt}"/>
                    <TextBlock Classes="muted" Text="{Binding ImportStatusMessage}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TabControl>
                <TabItem Header="{loc:Loc TabSingle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="4">
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="12">
                                        <TextBlock FontWeight="Bold" Text="{loc:Loc BasicInfo}"/>
                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="muted" Text="{loc:Loc LoadedBanks}"/>
                                            <ComboBox ItemsSource="{Binding LoadedProblems}" SelectedItem="{Binding SelectedLoadedProblem}" Width="520">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                            <StackPanel Orientation="Vertical">
                                                                <TextBlock FontWeight="Bold" Text="{Binding ProblemCode}"/>
                                                                <TextBlock Classes="muted" Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}"/>
                                                            </StackPanel>

                                                            <Button Grid.Column="1" Content="{loc:Loc Edit}" Margin="6,0,0,0" Command="{Binding DataContext.EditLoadedProblemCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                            <Button Grid.Column="2" Content="{loc:Loc Delete}" Classes="danger" Margin="6,0,0,0" Command="{Binding DataContext.DeleteLoadedProblemCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="muted" Text="{loc:Loc ProblemCode}"/>
                                            <TextBox Text="{Binding SingleProblemCode}" PlaceholderText="{loc:Loc ProblemCodePlaceholder}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Classes="muted" Text="{loc:Loc ExamType}"/>
                                            <TextBox Text="{Binding SingleExamType}" PlaceholderText="TQC / CPE / Leetcode"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <TextBlock Classes="muted" Text="{loc:Loc Difficulty}"/>
                                            <TextBox Text="{Binding SingleDifficulty}" PlaceholderText="1 / 2 / 3"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Spacing="6">
                                            <TextBlock Classes="muted" Text="{loc:Loc TitleLabel}"/>
                                            <TextBox Text="{Binding SingleTitle}" PlaceholderText="{loc:Loc TitleLabel}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                            <TextBlock Classes="muted" Text="{loc:Loc Status}"/>
                                            <TextBox Text="{Binding SingleStatus}" PlaceholderText="Draft / Active"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6">
                                            <TextBlock Classes="muted" Text="{loc:Loc SolutionLanguage}"/>
                                            <TextBox Text="{Binding SingleSolutionLanguage}" PlaceholderText="Python / C# / C++"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Spacing="6">
                                            <TextBlock Classes="muted" Text="{loc:Loc Description}"/>
                                            <TextBox Text="{Binding SingleDescription}" AcceptsReturn="True" AcceptsTab="True" MinHeight="120" TextWrapping="Wrap" PlaceholderText="{loc:Loc DescriptionPlaceholder}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock FontWeight="Bold" Text="{loc:Loc SolutionContent}"/>
                                    <TextBox Text="{Binding SingleSolutionCode}" AcceptsReturn="True" AcceptsTab="True" MinHeight="160" TextWrapping="Wrap" PlaceholderText="{loc:Loc SolutionPlaceholder}"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Padding="16">
                                    <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock FontWeight="Bold" VerticalAlignment="Center" Text="{loc:Loc TestAndValidation}"/>
                                            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding SingleTestCases.Count, Converter={StaticResource LocFmt}, ConverterParameter=TotalRowsFmt}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Content="{loc:Loc Add}" Classes="primary" Command="{Binding AddSingleProblemCommand}"/>
                                            <Button Content="{loc:Loc AddTestCase}" Command="{Binding AddSingleTestCaseCommand}"/>
                                            <Button Content="{loc:Loc ResetForm}" Classes="ghost" Command="{Binding ResetSingleFormCommand}"/>
                                            <Button Content="{loc:Loc ImportUpdate}" Classes="primary" Command="{Binding ImportSingleProblemCommand}"/>
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding SingleTestCases}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="list-item" Padding="12" Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="80,*,*,90,110" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Classes="muted" Text="{loc:Loc Order}"/>
                                                            <TextBox Text="{Binding OrderIndex}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Spacing="6">
                                                            <TextBlock Classes="muted" Text="{loc:Loc TestData}"/>
                                                            <TextBox Text="{Binding Input}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" PlaceholderText="{loc:Loc TestDataPlaceholder}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Spacing="6">
                                                            <TextBlock Classes="muted" Text="{loc:Loc ValidationData}"/>
                                                            <TextBox Text="{Binding ExpectedOutput}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" PlaceholderText="{loc:Loc ValidationDataPlaceholder}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Spacing="6">
                                                            <TextBlock Classes="muted" Text="{loc:Loc Example}"/>
                                                            <CheckBox IsChecked="{Binding IsExample}" Content="{loc:Loc Show}"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="4" Grid.RowSpan="2" Content="{loc:Loc Remove}" Classes="ghost" HorizontalAlignment="Stretch" Command="{Binding DataContext.RemoveSingleTestCaseCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{loc:Loc TabSheet}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="4">
                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock FontWeight="Bold" Text="{loc:Loc FileImportTemplate}"/>
                                    <TextBlock Classes="muted" Text="{loc:Loc SheetRowDesc}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{loc:Loc AddRow}" Command="{Binding AddSpreadsheetRowCommand}"/>
                                        <Button Content="{loc:Loc PickFile}" Classes="primary" Click="OnPickSpreadsheetClicked"/>
                                        <Button Content="{loc:Loc ValidateRows}" Command="{Binding ValidateSpreadsheetRowsCommand}"/>
                                        <Button Content="{loc:Loc PreviewValidate}" Click="OnPreviewSpreadsheetClicked"/>
                                        <Button Content="{loc:Loc ImportUpdate}" Classes="primary" Click="OnImportSpreadsheetClicked"/>
                                        <Button Content="{loc:Loc DownloadTemplate}" Classes="ghost" Click="OnDownloadTemplateClicked"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding SpreadsheetFilePath}" IsReadOnly="True" PlaceholderText="{loc:Loc NoFileSelected}"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="Bold" Text="{loc:Loc TemplateSpec}"/>
                                    <TextBlock Classes="muted" Text="{Binding TemplateSpecification}" TextWrapping="Wrap"/>
                                    <TextBlock Classes="muted" Text="{Binding TemplateNotes}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock FontWeight="Bold" Text="{loc:Loc PreviewResult}"/>
                                    <ItemsControl ItemsSource="{Binding PreviewRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="list-item" Padding="10" Margin="0,0,0,8">
                                                    <StackPanel Spacing="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Classes="muted" Text="{Binding RowNumber, Converter={StaticResource LocFmt}, ConverterParameter=RowFmt}"/>
                                                            <TextBlock Text="{Binding IsValid, StringFormat=Valid: {0}}"/>
                                                            <Button Content="{loc:Loc Remove}" Classes="ghost" Command="{Binding DataContext.RemoveSpreadsheetRowCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                        </StackPanel>

                                                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                                            <TextBox Text="{Binding ProblemCode}" PlaceholderText="ProblemCode"/>
                                                            <TextBox Grid.Column="1" Text="{Binding ExamType}" PlaceholderText="ExamType"/>
                                                            <TextBox Grid.Column="2" Text="{Binding Difficulty}" PlaceholderText="Difficulty"/>

                                                            <TextBox Grid.Row="1" Text="{Binding Title}" PlaceholderText="Title"/>
                                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Status}" PlaceholderText="Status"/>
                                                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SolutionLanguage}" PlaceholderText="SolutionLanguage"/>

                                                            <TextBox Grid.Row="2" Text="{Binding OrderIndex}" PlaceholderText="OrderIndex"/>
                                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding IsExample}" PlaceholderText="IsExample"/>
                                                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding SolutionCode}" PlaceholderText="SolutionCode"/>

                                                            <TextBox Grid.Row="3" Text="{Binding TestInput}" PlaceholderText="TestInput"/>
                                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ExpectedOutput}" PlaceholderText="ExpectedOutput"/>
                                                            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Description}" PlaceholderText="Description"/>
                                                        </Grid>

                                                        <TextBlock Classes="muted" Text="{Binding ValidationMessage}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock FontWeight="Bold" Text="{loc:Loc ValidationMessages}"/>
                                    <ItemsControl ItemsSource="{Binding ValidationIssues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="muted" Padding="8" CornerRadius="8" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding RowNumber, Converter={StaticResource LocFmt}, ConverterParameter=RowFmt}" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Field, Converter={StaticResource LocFmt}, ConverterParameter=FieldFmt}"/>
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
