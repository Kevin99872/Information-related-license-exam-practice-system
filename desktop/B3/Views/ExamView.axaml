<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:B3.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="B3.Views.ExamView"
             x:DataType="vm:ExamViewModel">

    <UserControl.Styles>
        <Style Selector="Border.exam-shell">
            <Setter Property="Background" Value="#111722"/>
            <Setter Property="BorderBrush" Value="#263247"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style Selector="Border.exam-panel">
            <Setter Property="Background" Value="#0F1722"/>
            <Setter Property="BorderBrush" Value="#24334B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style Selector="TextBlock.exam-title">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBox.exam-output">
            <Setter Property="Background" Value="#101923"/>
            <Setter Property="BorderBrush" Value="#2A3A53"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,monospace"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style Selector="TextBox.exam-editor">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="BorderBrush" Value="#2A3A53"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,monospace"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style Selector="Border.result-card">
            <Setter Property="Background" Value="#101821"/>
            <Setter Property="BorderBrush" Value="#24334B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <!-- 考前設定卡 -->
        <Border Grid.Row="0" Classes="exam-shell" IsVisible="{Binding IsExamInactive}">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="模擬考試設定" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Classes="muted" Text="確認題庫、題數與考試時間後再開始。"/>
                </StackPanel>

                <Grid ColumnDefinitions="1.2*,0.8*" ColumnSpacing="16">
                    <StackPanel Spacing="12">
                        <Border Classes="exam-panel">
                            <StackPanel Spacing="10">
                                <TextBlock Text="考試資訊" Classes="exam-title"/>
                                <TextBlock Text="{Binding ExamTitle}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Classes="muted" Text="{Binding SelectedExamCard.Description}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="exam-panel">
                            <StackPanel Spacing="10">
                                <TextBlock Text="設定項目" Classes="exam-title"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                    <TextBlock Text="考試種類" Classes="muted" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ExamTypes}" SelectedItem="{Binding EditableExamType}" Height="36"/>

                                    <TextBlock Grid.Row="1" Text="考題數量" Classes="muted" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="{Binding AvailableQuestionCount}" Value="{Binding EditableQuestionCount}" Height="36"/>

                                    <TextBlock Grid.Row="2" Text="考試時間" Classes="muted" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="10" Maximum="180" Value="{Binding EditableExamDurationMinutes}" Height="36"/>

                                    <TextBlock Grid.Row="3" Text="語言" Classes="muted" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Height="36"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="12" Grid.Column="1">
                        <Border Classes="exam-panel">
                            <StackPanel Spacing="10">
                                <TextBlock Text="題庫狀態" Classes="exam-title"/>
                                <TextBlock Text="{Binding AvailableQuestionCount, StringFormat='可用題庫：{0} 題'}"/>
                                <TextBlock Text="{Binding EditableQuestionCount, StringFormat='本次題數：{0} 題'}"/>
                                <TextBlock Text="{Binding ExamTimerPreviewText, StringFormat='時間預覽：{0}'}"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="exam-panel">
                            <StackPanel Spacing="12">
                                <TextBlock Text="操作" Classes="exam-title"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="確認開始" Classes="primary" Command="{Binding StartExamCommand}" Height="40"/>
                                    <Button Content="取消" Classes="ghost" Command="{Binding CancelExamSetupCommand}" Height="40"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 考試進行中 -->
        <Border Grid.Row="0" Classes="exam-shell" IsVisible="{Binding IsExamActive}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="20">
                <TextBlock Text="{Binding ExamTitle}" FontSize="18" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="{Binding RemainingTimeText, StringFormat='剩餘時間：{0}'}"/>
                <TextBlock Grid.Column="2" Text="{Binding ProblemCountText, StringFormat='題號：{0}'}"/>
                <TextBlock Grid.Column="3" Text="{Binding TotalProblems, StringFormat='總題數：{0}'}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- 題目與程式區：一頁式滿版 -->
        <Grid Grid.Row="1" ColumnDefinitions="1.05*,0.95*" ColumnSpacing="14" IsEnabled="{Binding IsExamActive}">
            <Grid Grid.Column="0" RowDefinitions="1.05*,0.95*" RowSpacing="12">
                <Border Classes="exam-panel" Grid.Row="0">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock Text="{Binding CurrentProblem.ProblemCode}" FontWeight="Bold" Foreground="#8DC3FF"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentProblem.Title}" Classes="exam-title" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding ScoreGrade}" Classes="muted" VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding CurrentProblem.Description}" AcceptsReturn="True" IsReadOnly="True" Classes="exam-output" MinHeight="180"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Classes="exam-panel" Grid.Row="1">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <TextBlock Text="示例測試案例" Classes="exam-title"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding CurrentTestCases}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="8" BorderBrush="#25364E" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontWeight="Bold" Text="{Binding Input, StringFormat='Input: {0}'}"/>
                                            <TextBlock Classes="muted" Text="{Binding ExpectedOutput, StringFormat='Output: {0}'}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="12">
                <Border Classes="exam-panel" Grid.Row="0">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Code Space" Classes="exam-title"/>
                                <TextBlock Text="{Binding EditorStatusText}" Classes="muted" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ComboBox Width="120" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"/>
                                <Button Content="試跑程式" Classes="ghost" Height="36" Command="{Binding RunCodeCommand}" IsEnabled="{Binding IsExamActive}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="160,*" ColumnSpacing="12">
                            <Border Background="#0D1117" CornerRadius="8" BorderBrush="#24334B" BorderThickness="1" Padding="10">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="檔案選單" Classes="exam-title" FontSize="14"/>
                                    <ListBox ItemsSource="{Binding EditorFiles}" SelectedItem="{Binding SelectedEditorFile}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Spacing="2" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="10">
                                <Border Background="#0D1117" CornerRadius="8" BorderBrush="#24334B" BorderThickness="1" Padding="12">
                                    <Grid ColumnDefinitions="56,*" ColumnSpacing="10">
                                        <Border Background="#101926" CornerRadius="6" Padding="8">
                                            <TextBlock Text="{Binding EditorLineNumbers}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="13" Foreground="#718096" TextAlignment="Right"/>
                                        </Border>
                                        <TextBox Grid.Column="1" Text="{Binding EditorBuffer}" AcceptsReturn="True" AcceptsTab="True" Classes="exam-editor" FontFamily="Cascadia Code,Consolas,monospace" FontSize="13" LineHeight="20" MinHeight="260"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Background="#101923" CornerRadius="8" BorderBrush="#24334B" BorderThickness="1" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="執行結果" Classes="exam-title" FontSize="14"/>
                                        <TextBox Text="{Binding OutputResult}" AcceptsReturn="True" IsReadOnly="True" Classes="exam-output" MinHeight="120"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Classes="exam-panel" Grid.Row="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="判題狀態" Classes="exam-title"/>
                        <TextBlock Text="{Binding LastSubmissionStatusText}" FontWeight="SemiBold" Foreground="#FFC266"/>
                        <TextBlock Text="{Binding LastSubmissionDetailText}" Classes="muted" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 操作列 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" IsEnabled="{Binding IsExamActive}">
            <Button Content="提交答案" Width="120" Classes="primary" Command="{Binding SubmitAnswerCommand}" IsEnabled="{Binding IsNotJudging}"/>
            <Button Content="跳過" Width="120" Classes="ghost" Command="{Binding SkipProblemCommand}"/>
            <Button Content="結束考試" Width="120" Classes="ghost" Command="{Binding EndExamCommand}"/>
        </StackPanel>

    </Grid>

</UserControl>
