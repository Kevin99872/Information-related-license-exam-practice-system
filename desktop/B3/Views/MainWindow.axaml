<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:B3.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:B3"
        xmlns:loc="using:B3.Localization"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="B3.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Icon="avares://B3/Assets/app-icon.png"
        Title="{loc:Loc AppTitle}"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- 側欄展開時文字淡入 -->
        <Style Selector=":is(Control).sidebar-fade[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:0.18" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="Auto,*">
        <!-- 左側導航欄 (改為使用 RenderTransform 動畫以避免佈局重排) -->
        <Border Background="{DynamicResource SidebarBgBrush}"
                Padding="16"
                Grid.Column="0"
            Width="{Binding SidebarWidth}"
                PointerEntered="OnSidebarPointerEntered"
                PointerExited="OnSidebarPointerExited">
            <Grid Name="SidebarInner">
                <Grid.RenderTransform>
                    <TranslateTransform X="0"/>
                </Grid.RenderTransform>
                <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8" Classes="sidebar-fade" IsVisible="{Binding IsSidebarExpanded}">
                        <Image Source="avares://B3/Assets/app-icon.png" Width="24" Height="24" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc AppName}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Ver v1.2.0" Classes="muted sidebar-fade" FontSize="12" IsVisible="{Binding IsSidebarExpanded}"/>
                    <Button Content="menu" HorizontalAlignment="Left"  Command="{Binding ToggleSidebarCommand}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,24,0,0" Spacing="10">
                    <TextBlock Text="{loc:Loc MainMenu}" FontSize="12" Classes="muted sidebar-fade" IsVisible="{Binding IsSidebarExpanded}"/>
                    <ListBox Classes="nav-menu" ItemsSource="{Binding MainItems}" SelectedItem="{Binding SelectedMainItem}" IsEnabled="{Binding CanNavigate}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" CornerRadius="6">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="{Binding ShortTitle}" Width="24" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="sidebar-fade" IsVisible="{Binding DataContext.IsSidebarExpanded, ElementName=Root}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,24,0,0" Spacing="10">
                    <TextBlock Text="{loc:Loc Tools}" FontSize="12" Classes="muted sidebar-fade" IsVisible="{Binding IsSidebarExpanded}"/>
                    <ListBox Classes="nav-menu" ItemsSource="{Binding ToolItems}" SelectedItem="{Binding SelectedToolItem}" IsEnabled="{Binding CanNavigate}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" CornerRadius="6">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="{Binding ShortTitle}" Width="24" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="sidebar-fade" IsVisible="{Binding DataContext.IsSidebarExpanded, ElementName=Root}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Margin="0,24,0,0" Content="{loc:Loc Settings}" Command="{Binding OpenSettingsCommand}" IsEnabled="{Binding CanNavigate}"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- 主內容區 - 使用 ViewLocator 自動映射 ViewModel 到 View
             過渡效果由 ViewModel 控制: 一般頁面為滑動+淡化，設定頁為直接切換 (null) -->
        <TransitioningContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="24"
                                     PageTransition="{Binding PageTransition}">
            <TransitioningContentControl.ContentTemplate>
                <local:ViewLocator/>
            </TransitioningContentControl.ContentTemplate>
        </TransitioningContentControl>
    </Grid>

</Window>
