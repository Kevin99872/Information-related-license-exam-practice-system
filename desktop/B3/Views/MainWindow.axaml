<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:B3.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:B3"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="B3.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="智慧考試系統 - B3"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- 頂部菜單欄 -->
        <Border DockPanel.Dock="Top" Background="#F0F0F0">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="題目瀏覽" Command="{Binding ShowProblemListCommand}"/>
                <Button Content="開始考試" Command="{Binding ShowExamCommand}"/>
                <Button Content="題目審核" Command="{Binding ShowReviewCommand}"/>
                <Button Content="設定" Command="{Binding ShowSettingsCommand}"/>
            </StackPanel>
        </Border>

        <!-- 主內容區 - 使用 ViewLocator 自動映射 ViewModel 到 View -->
        <ContentControl Content="{Binding CurrentView}" DockPanel.Dock="Top" Margin="10">
            <ContentControl.ContentTemplate>
                <local:ViewLocator/>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </DockPanel>

</Window>
