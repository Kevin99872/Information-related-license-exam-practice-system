<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:B3.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:B3"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="B3.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Icon="avares://B3/Assets/logo.png"
        Title="智慧考試系統 - B3"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,*">
        <!-- 左側導航欄 -->
        <Border Background="{DynamicResource SidebarBgBrush}"
                Padding="16"
                Grid.Column="0"
                Width="{Binding SidebarWidth}"
                PointerEntered="OnSidebarPointerEntered"
                PointerExited="OnSidebarPointerExited">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.2"/>
                </Transitions>
            </Border.Transitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                    <TextBlock Text="智慧考照" FontSize="16" FontWeight="Bold" IsVisible="{Binding IsSidebarExpanded}"/>
                    <TextBlock Text="ExamAI v1.0" Classes="muted" FontSize="12" IsVisible="{Binding IsSidebarExpanded}"/>
                    <Button Content="menu" HorizontalAlignment="Left"  Command="{Binding ToggleSidebarCommand}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,24,0,0" Spacing="10">
                    <TextBlock Text="主選單" FontSize="12" Classes="muted" IsVisible="{Binding IsSidebarExpanded}"/>
                    <ListBox Classes="nav-menu" ItemsSource="{Binding MainItems}" SelectedItem="{Binding SelectedMainItem}" IsEnabled="{Binding CanNavigate}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" CornerRadius="6">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="{Binding ShortTitle}" Width="24" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" IsVisible="{Binding DataContext.IsSidebarExpanded, ElementName=Root}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,24,0,0" Spacing="10">
                    <TextBlock Text="工具" FontSize="12" Classes="muted" IsVisible="{Binding IsSidebarExpanded}"/>
                    <ListBox Classes="nav-menu" ItemsSource="{Binding ToolItems}" SelectedItem="{Binding SelectedToolItem}" IsEnabled="{Binding CanNavigate}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" CornerRadius="6">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="{Binding ShortTitle}" Width="24" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" IsVisible="{Binding DataContext.IsSidebarExpanded, ElementName=Root}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Margin="0,24,0,0" Content="設定" Command="{Binding OpenSettingsCommand}" IsEnabled="{Binding CanNavigate}"/>
            </DockPanel>
        </Border>

        <!-- 主內容區 - 使用 ViewLocator 自動映射 ViewModel 到 View -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="24">
            <ContentControl.ContentTemplate>
                <local:ViewLocator/>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>

</Window>
