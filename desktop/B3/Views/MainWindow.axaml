<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:B3.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:B3"
        xmlns:loc="using:B3.Localization"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="B3.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Icon="avares://B3/Assets/app-icon.png"
        Title="{loc:Loc AppTitle}"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- 側欄展開時文字淡入 -->
        <Style Selector=":is(Control).sidebar-fade[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:0.18" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="Auto,*">
        <!-- 左側導航欄：寬度變化以 Transition 平滑過渡；收合時只顯示圖示 -->
        <Border Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="12,16"
                Grid.Column="0"
                ClipToBounds="True"
                Width="{Binding SidebarWidth}"
                PointerEntered="OnSidebarPointerEntered"
                PointerExited="OnSidebarPointerExited">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>

            <DockPanel>
                <!-- 標題與收合按鈕 -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Height="44">
                    <Button Classes="nav-button" HorizontalAlignment="Left" Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="{loc:Loc MainMenu}">
                        <Path Data="M1 3h14v2H1zM1 7h14v2H1zM1 11h14v2H1z"/>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="6,0,0,0"
                                Classes="sidebar-fade" IsVisible="{Binding IsSidebarExpanded}">
                        <Image Source="avares://B3/Assets/app-icon.png" Width="24" Height="24" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc AppName}" FontSize="15" FontWeight="Bold" TextWrapping="NoWrap"/>
                            <TextBlock Text="v1.2.0" Classes="muted" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 設定 (固定在底部) -->
                <Button DockPanel.Dock="Bottom" Classes="nav-button" Margin="0,12,0,0"
                        Command="{Binding OpenSettingsCommand}" IsEnabled="{Binding CanNavigate}"
                        ToolTip.Tip="{loc:Loc Settings}">
                    <Grid ColumnDefinitions="24,*">
                        <Path HorizontalAlignment="Left"
                              Data="F0 M7 1h2l.3 1.9 1.5.6 1.6-1.1 1.4 1.4-1.1 1.6.6 1.5L15 7v2l-1.9.3-.6 1.5 1.1 1.6-1.4 1.4-1.6-1.1-1.5.6L9 15H7l-.3-1.9-1.5-.6-1.6 1.1-1.4-1.4 1.1-1.6-.6-1.5L1 9V7l1.9-.3.6-1.5-1.1-1.6 1.4-1.4 1.6 1.1 1.5-.6zM8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"/>
                        <TextBlock Grid.Column="1" Text="{loc:Loc Settings}" FontWeight="Medium" TextWrapping="NoWrap"
                                   Classes="sidebar-fade" IsVisible="{Binding IsSidebarExpanded}"/>
                    </Grid>
                </Button>

                <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0" Spacing="6">
                    <TextBlock Text="{loc:Loc MainMenu}" FontSize="11" Margin="12,0,0,0" TextWrapping="NoWrap"
                               Classes="muted sidebar-fade" IsVisible="{Binding IsSidebarExpanded}"/>
                    <ListBox Classes="nav-menu" ItemsSource="{Binding MainItems}" SelectedItem="{Binding SelectedMainItem}" IsEnabled="{Binding CanNavigate}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Grid ColumnDefinitions="24,*" Margin="12,10" ToolTip.Tip="{Binding Title}">
                                    <Path Data="{Binding Icon}" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="NoWrap" Classes="sidebar-fade"
                                               IsVisible="{Binding #Root.((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,18,0,0" Spacing="6">
                    <TextBlock Text="{loc:Loc Tools}" FontSize="11" Margin="12,0,0,0" TextWrapping="NoWrap"
                               Classes="muted sidebar-fade" IsVisible="{Binding IsSidebarExpanded}"/>
                    <ListBox Classes="nav-menu" ItemsSource="{Binding ToolItems}" SelectedItem="{Binding SelectedToolItem}" IsEnabled="{Binding CanNavigate}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Grid ColumnDefinitions="24,*" Margin="12,10" ToolTip.Tip="{Binding Title}">
                                    <Path Data="{Binding Icon}" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="NoWrap" Classes="sidebar-fade"
                                               IsVisible="{Binding #Root.((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Panel/>
            </DockPanel>
        </Border>

        <!-- 主內容區 - 使用 ViewLocator 自動映射 ViewModel 到 View
             過渡效果由 ViewModel 控制: 一般頁面為滑動+淡化，設定頁為極短淡入 -->
        <TransitioningContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="24,20"
                                     PageTransition="{Binding PageTransition}">
            <TransitioningContentControl.ContentTemplate>
                <local:ViewLocator/>
            </TransitioningContentControl.ContentTemplate>
        </TransitioningContentControl>
    </Grid>

</Window>
